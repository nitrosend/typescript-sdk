{
  "name": "@nitrosend/sdk",
  "version": "0.11.12",
  "description": "Node.js/TypeScript SDK for the Nitrosend API",
  "license": "MIT",
  "homepage": "https://github.com/nitrosend/typescript-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrosend/typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/nitrosend/typescript-sdk/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && node scripts/generate-version.mjs && tsc && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "dev": "tsc --watch",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "prepare": "npm run build",
    "test:package": "npm run build && node scripts/check-package.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
