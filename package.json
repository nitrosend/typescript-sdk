{
  "name": "@nitrosend/sdk",
  "version": "0.11.3",
  "description": "Node.js/TypeScript SDK for the Nitrosend API",
  "license": "MIT",
  "homepage": "https://github.com/nitrosend/typescript-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrosend/typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/nitrosend/typescript-sdk/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && node scripts/generate-version.mjs && tsc",
    "dev": "tsc --watch",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
